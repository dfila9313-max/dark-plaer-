# Copy to .env for local development. Never commit real secrets.
ADMINO_ENVIRONMENT=development
ADMINO_DATABASE_URL=postgresql+asyncpg://admino:admino@localhost:5432/admino
ADMINO_SECRET_KEY=dev-only-change-me
ADMINO_CORS_ORIGINS=["http://localhost:3000"]
ADMINO_LOG_LEVEL=INFO
ADMINO_WEB_URL=http://localhost:3000
# Email: Mailpit catches everything in development (http://localhost:8025)
ADMINO_EMAIL_BACKEND=smtp
ADMINO_SMTP_HOST=localhost
ADMINO_SMTP_PORT=1025
